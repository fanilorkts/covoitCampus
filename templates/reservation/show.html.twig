{% extends 'base.html.twig' %}

{% block title %}Booking{% endblock %}

{% block body %}
<div class="page page--narrow">
    <header class="page-head"><h1 class="page-title">Booking #{{ reservation.id }}</h1></header>

    <div class="table-wrap">
        <table class="table table--details">
            <tbody>
                <tr><th>Ride</th><td>{{ reservation.idTrajet.origine }} → {{ reservation.idTrajet.destination }}</td></tr>
                <tr><th>Status</th><td><span class="badge {{ reservation.statut == 'En attente' ? 'badge--pending' : (reservation.statut == 'Refusée' ? 'badge--refused') }}">{{ reservation.statut }}</span></td></tr>
                <tr><th>Booked on</th><td>{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y') : '' }}</td></tr>
            </tbody>
        </table>
    </div>

    <div class="btn-row">
        <a class="btn btn--secondary" href="{{ path('app_reservation_mes_reservations') }}">My bookings</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn--edit" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Edit</a>
            {{ include('reservation/_delete_form.html.twig') }}
        {% endif %}
    </div>
</div>
{% endblock %}
