{% extends 'base.html.twig' %}

{% block title %}All bookings{% endblock %}

{% block body %}
<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-title">All bookings</h1>
            <p class="page-subtitle">Administration view.</p>
        </div>
        <a class="btn btn--primary" href="{{ path('app_reservation_new') }}">New booking</a>
    </header>

    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Id</th><th>Status</th><th>Booked on</th><th></th></tr></thead>
            <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.id }}</td>
                    <td><span class="badge {{ reservation.statut == 'En attente' ? 'badge--pending' : (reservation.statut == 'Refusée' ? 'badge--refused') }}">{{ reservation.statut }}</span></td>
                    <td>{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y') : '' }}</td>
                    <td>
                        <div class="actions">
                            <a class="btn btn--secondary" href="{{ path('app_reservation_show', {'id': reservation.id}) }}">Show</a>
                            <a class="btn btn--edit" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Edit</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">No booking yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
