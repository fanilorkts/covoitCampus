{% extends 'base.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block body %}
    <h1>Mes Réservations</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Trajets</th>
                <th>Date du trajet</th>
                <th>Date de réservation</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
        {% for r  in reservations %}
            <tr>
                <td><a href="{{path('app_trajets_show', {'id' : r.idTrajet.id})}}">{{ r.idTrajet.origine }} → {{ r.idTrajet.destination }}</a></td>
                <td>{{ r.idTrajet.dateHeure|date('d-m-Y H:i') }}</td>
                <td>{{ r.dateReservation ? r.dateReservation|date('Y-m-d') : '' }}</td>
                <td>{{ r.statut }}</td>
                <td>
                    <form method="post" action="{{ path('app_reservation_annuler', {'id': r.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ r.id) }}">
                        <button type="submit">Annuler</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun trajet trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reservation_new') }}">Trajets disponibles</a>
{% endblock %}