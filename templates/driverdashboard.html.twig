{% extends 'base.html.twig' %}

{% block title %}Driver dashboard{% endblock %}

{% block body %}
<div class="container">

    <h1 class="page-title">Welcome back, {{ user.prenom }}!</h1>
    <p class="page-subtitle">Here's what's happening with your rides</p>

    <div class="dashboard">

        {# ---------- Statistiques ---------- #}
        <section>
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-card__icon">🚗</div>
                    <div class="stat-card__value">{{ stats.rides }}</div>
                    <div class="stat-card__label">Rides shared</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__icon">€</div>
                    <div class="stat-card__value">{{ stats.money|number_format(0, ',', ' ') }}€</div>
                    <div class="stat-card__label">Money shared</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__icon">🍃</div>
                    <div class="stat-card__value">{{ stats.co2 }}kg</div>
                    <div class="stat-card__label">CO2 saved</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__icon">★</div>
                    <div class="stat-card__value">{{ stats.rating ?? '–' }}</div>
                    <div class="stat-card__label">Your driver rating</div>
                </div>
            </div>
        </section>

        {# ---------- Demandes de réservation ---------- #}
        <section>
            <div class="section-head"><h2>Ride requests</h2></div>
            <div class="request-list">
                {% for r in requests %}
                    <article class="request-card">
                        <div>
                            <strong>{{ r.idPassager.prenom }} wants a seat</strong>
                            <small>
                                {{ r.idTrajet.origine }} → {{ r.idTrajet.destination }}<br>
                                {{ r.idTrajet.dateHeure|date('d/m/Y H:i') }}
                            </small>
                        </div>
                        <div class="request-card__actions">
                            {# TODO : brancher sur tes routes d'acceptation / refus #}
                            <form method="post" action="{{ path('app_reservation_accepter', {'id': r.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('accepter' ~ r.id) }}">
    <button type="submit" class="btn btn--accept">Accept</button>
</form>
<form method="post" action="{{ path('app_reservation_refuser', {'id': r.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ r.id) }}">
    <button type="submit" class="btn btn--ghost">Decline</button>
</form>
                        </div>
                    </article>
                {% else %}
                    <p class="page-subtitle">No pending requests.</p>
                {% endfor %}
            </div>
        </section>

        {# ---------- Trajets à venir ---------- #}
        <section class="dashboard__full">
            <div class="section-head">
                <h2>Upcoming rides</h2>
                <a href="{{ path('app_trajets_mes_trajets') }}">View all</a>
            </div>
            <div class="ride-list">
                {% for t in upcoming %}
                    <div class="ride-row">
                        <article class="ride-card">
                            <div>
                                <span class="badge {{ t.statut == 'Complet' ? 'badge--pending' : '' }}">
                                    {{ t.statut == 'Complet' ? 'Full' : 'Open' }}
                                </span>
                                <div class="ride-card__route">{{ t.origine }} → {{ t.destination }}</div>
                                <div class="ride-card__meta">{{ t.placesRestantes }} seats left</div>
                            </div>
                            <div class="ride-card__date">{{ t.dateHeure|date('d/m/Y') }}<br>{{ t.dateHeure|date('H:i') }}</div>
                        </article>
                        <div class="ride-price">
                            <span>{{ t.prix is not null ? t.prix ~ '€' : '–' }}</span>
                            <div class="ride-price__actions">
                                {# TODO : brancher sur tes routes d'édition / annulation #}
                                <a class="btn btn--edit" href="{{ path('app_trajets_edit', {'id': t.id}) }}">Edit</a>
<a class="btn btn--ghost" href="{{ path('app_trajets_show', {'id': t.id}) }}">Details</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="page-subtitle">No upcoming rides.</p>
                {% endfor %}
            </div>
        </section>

        {# ---------- Trajets passés ---------- #}
        <section>
            <div class="section-head">
                <h2>Past rides</h2>
                <a href="{{ path('app_trajets_mes_trajets') }}">View all</a>
            </div>
            <div class="ride-list">
                {% for t in past %}
                    <article class="ride-card">
                        <div>
                            <span class="badge">Done</span>
                            <div class="ride-card__route">{{ t.origine }} → {{ t.destination }}</div>
                        </div>
                        <div class="ride-card__date">{{ t.dateHeure|date('d/m/Y') }}<br>{{ t.dateHeure|date('H:i') }}</div>
                    </article>
                {% else %}
                    <p class="page-subtitle">No past rides yet.</p>
                {% endfor %}
            </div>
        </section>

        {# ---------- Avis ---------- #}
        <section>
            <div class="section-head">
                <h2>Reviews</h2>
                <a href="{{ path('app_profil', {id: user.id}) }}">View all</a>
            </div>
            <div class="review-list">
                {% for a in reviews %}
                    <article class="review-card">
                        <div>
                            <strong>{{ a.commentaire }}</strong>
                            <small>From {{ a.auteur.prenom }}</small>
                        </div>
                        <span class="stars" aria-label="{{ a.note }} sur 5">
                            {% for i in 1..a.note %}★{% endfor %}
                        </span>
                    </article>
                {% else %}
                    <p class="page-subtitle">No reviews yet.</p>
                {% endfor %}
            </div>
        </section>

        {# ---------- Véhicule(s) ---------- #}
        <section>
            <div class="section-head">
                <h2>Vehicle{{ vehicules|length > 1 ? 's' : '' }}</h2>
                <a href="{{ path('app_vehicule_index') }}">Manage</a>
            </div>
            {% for v in vehicules %}
                <div class="vehicle">
                    <div class="field">{{ v.marque }}</div>
                    <div class="field">{{ v.modele }}</div>
                    <div class="field">{{ v.annee ?? '–' }}</div>
                    <div class="vehicle__icon">icon</div>
                    <div class="field">{{ v.immatriculation }}</div>
                    <div class="field">{{ v.nbPlaces }} seats</div>
                    <div class="field">{{ v.couleur ?? '–' }}</div>
                </div>
            {% else %}
                <p class="page-subtitle">No vehicle yet. <a href="{{ path('app_vehicule_new') }}">Add your vehicle</a></p>
            {% endfor %}
        </section>

        {# ---------- Profil ---------- #}
        <section>
            <div class="section-head">
                <h2>Profile</h2>
                <a href="{{ path('app_profil', {id: user.id}) }}">View all</a>
            </div>
            <div class="profile">
                <div class="profile__card">
                    <span class="avatar avatar--lg">{{ user.prenom|first|upper }}</span>
                    <strong>{{ user.prenom }} {{ user.nom }}</strong>
                    <dl>
                        <dt>Date of birth</dt>
                        <dd>{{ user.dateNaissance ? user.dateNaissance|date('d/m/Y') : '–' }}</dd>
                    </dl>
                </div>
                <div class="profile__note">
                    <h3>Bio</h3>
                    {{ user.biographie ?? '–' }}
                </div>
                <div class="profile__note">
                    <h3>Interests</h3>
                    {{ user.centresInteret ?? '–' }}
                </div>
            </div>
        </section>

    </div>
</div>
{% endblock %}
