{% extends 'base.html.twig' %}

{% block title %}Trajets{% endblock %}

{% block body %}
    <h1>Trajets</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ trajet.id }}</td>
            </tr>
            <tr>
                <th>Origine</th>
                <td>{{ trajet.origine }}</td>
            </tr>
            <tr>
                <th>Destination</th>
                <td>{{ trajet.destination }}</td>
            </tr>
            <tr>
                <th>Date_heure</th>
                <td>{{ trajet.dateHeure ? trajet.dateHeure|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Places_totales</th>
                <td>{{ trajet.placesTotales }}</td>
            </tr>
            <tr>
                <th>Places_restantes</th>
                <td>{{ trajet.placesRestantes }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ trajet.statut }}</td>
            </tr>
        </tbody>
    </table>

    {% if trajet.statut == constant ('App\\Entity\\Trajets::STATUTS_OUVERT') and app.user != trajet.idConducteur %}
        <form method="post" action="{{ path('app_reservation_new_trajet', {'id': trajet.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('reserver' ~ trajet.id) }}">
            <p>Conducteur :
                <a href="{{ path('app_profil', {'id': trajet.idConducteur.id}) }}">{{ trajet.idConducteur.prenom }} {{ trajet.idConducteur.nom }}</a>
                ({% if noteConducteur > 0 %}{{ noteConducteur|number_format(1, ',') }}/5{% else %}pas encore noté{% endif %})
            </p>
            <button class="btn btn-success">Réserver</button>
        </form>

    {% endif %}

    {% if app.user and app.user == trajet.idConducteur %}
        <h2>Demandes en attente</h2>
        {% for r in reservations %}
            <div>
                <a href="{{ path('app_profil', {'id': r.idPassager.id}) }}">{{ r.idPassager.prenom }} {{ r.idPassager.nom }}</a>
                ({% if notes[r.idPassager.id] > 0 %}{{ notes[r.idPassager.id]|number_format(1, ',') }}/5{% else %}pas encore noté{% endif %})
                - {{ r.statut }} 
                {%  if r.statut == constant ('App\\Entity\\Reservation::STATUS_EN_ATTENTE') %}
                    <form method="post" action="{{ path('app_reservation_accepter', {'id': r.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('accepter' ~ r.id) }}">
                        <button class="btn btn-success">Accepter</button>
                    </form>
                    <form method="post" action="{{ path('app_reservation_refuser', {'id': r.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ r.id) }}">
                        <button class="btn btn-danger">Refuser</button>
                    </form>
                {% endif %}
            </div>
    {% else %}
        <p>Aucune demande pour le moment.</p>
        {% endfor %}
    {% endif %}
    {% if app.user and app.user.id == trajet.idConducteur.id and trajet.statut != constant('App\\Entity\\Trajets::STATUTS_TERMINE') %}
        <form method="post" action="{{ path('app_trajets_terminer', {'id': trajet.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ trajet.id) }}">
            <button class="btn">Marquer comme terminé</button>
        </form>
    {% endif %}
    {% if app.user and trajet.statut == constant('App\\Entity\\Trajets::STATUTS_TERMINE') %}
    <h2>Noter</h2>
    {% for r in reservations %}
        {% if r.statut == constant('App\\Entity\\Reservation::STATUS_CONFIRME') %}
            {% if app.user.id == trajet.idConducteur.id %}
                <a href="{{ path('app_avis_noter', {'id': trajet.id, 'cibleId': r.idPassager.id}) }}">Noter {{ r.idPassager.prenom }}</a>
            {% elseif app.user.id == r.idPassager.id %}
                <a href="{{ path('app_avis_noter', {'id': trajet.id, 'cibleId': trajet.idConducteur.id}) }}">Noter le conducteur</a>
            {% endif %}
        {% endif %}
    {% endfor %}
{% endif %}
    <a href="{{ path('app_trajets_index') }}">back to list</a>

    <a href="{{ path('app_trajets_edit', {'id': trajet.id}) }}">edit</a>

    {{ include('trajets/_delete_form.html.twig') }}
{% endblock %}
