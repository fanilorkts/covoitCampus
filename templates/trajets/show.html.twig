{% extends 'base.html.twig' %}

{% block title %}{{ trajet.origine }} → {{ trajet.destination }}{% endblock %}

{% block body %}
{% set isOwner = app.user and trajet.idConducteur and app.user.id == trajet.idConducteur.id %}
{% set isOpen = trajet.statut == constant('App\\Entity\\Trajets::STATUTS_OUVERT') %}
{% set isDone = trajet.statut == constant('App\\Entity\\Trajets::STATUTS_TERMINE') %}

<div class="page page--narrow">
    <header class="page-head">
        <div>
            <h1 class="page-title">{{ trajet.origine }} → {{ trajet.destination }}</h1>
            <p class="page-subtitle">
                <span class="badge {{ isDone ? 'badge--done' : (trajet.statut == 'Complet' ? 'badge--full') }}">{{ trajet.statut }}</span>
            </p>
        </div>
    </header>

    <div class="table-wrap">
        <table class="table table--details">
            <tbody>
                <tr><th>Departure</th><td>{{ trajet.origine }}</td></tr>
                <tr><th>Destination</th><td>{{ trajet.destination }}</td></tr>
                <tr><th>Date</th><td>{{ trajet.dateHeure ? trajet.dateHeure|date('d/m/Y H:i') : '' }}</td></tr>
                <tr><th>Seats</th><td>{{ trajet.placesRestantes }} left / {{ trajet.placesTotales }}</td></tr>
                <tr><th>Price</th><td>{{ trajet.prix|number_format(2, ',', ' ') }} €</td></tr>
                <tr>
                    <th>Driver</th>
                    <td>
                        {% if app.user %}
                            <a href="{{ path('app_profil', {'id': trajet.idConducteur.id}) }}">{{ trajet.idConducteur.prenom }} {{ trajet.idConducteur.nom }}</a>
                        {% else %}
                            {{ trajet.idConducteur.prenom }}
                        {% endif %}
                        ({% if noteConducteur > 0 %}{{ noteConducteur|number_format(1, ',') }}/5{% else %}not rated yet{% endif %})
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="btn-row">
        {% if isOpen and not isOwner %}
            {% if app.user %}
                <form method="post" action="{{ path('app_reservation_new_trajet', {'id': trajet.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reserver' ~ trajet.id) }}">
                    <button class="btn btn--accept">Book a seat</button>
                </form>
            {% else %}
                <a class="btn btn--accept" href="{{ path('app_login') }}">Log in to book</a>
            {% endif %}
        {% endif %}

        {% if isOwner and not isDone %}
            <form method="post" action="{{ path('app_trajets_terminer', {'id': trajet.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ trajet.id) }}">
                <button class="btn btn--primary">Mark as completed</button>
            </form>
        {% endif %}

        {% if isOwner %}
            <a class="btn btn--edit" href="{{ path('app_trajets_edit', {'id': trajet.id}) }}">Edit</a>
            {{ include('trajets/_delete_form.html.twig') }}
        {% endif %}
    </div>

    {% if isOwner %}
        <h2>Booking requests</h2>
        <div class="panel">
            {% for r in reservations %}
                <div class="request-row">
                    <div>
                        <a href="{{ path('app_profil', {'id': r.idPassager.id}) }}">{{ r.idPassager.prenom }} {{ r.idPassager.nom }}</a>
                        ({% if notes[r.idPassager.id] > 0 %}{{ notes[r.idPassager.id]|number_format(1, ',') }}/5{% else %}not rated yet{% endif %})
                        <span class="badge {{ r.statut == 'En attente' ? 'badge--pending' : (r.statut == 'Refusée' ? 'badge--refused') }}">{{ r.statut }}</span>
                    </div>
                    {% if r.statut == constant('App\\Entity\\Reservation::STATUS_EN_ATTENTE') %}
                        <div>
                            <form method="post" action="{{ path('app_reservation_accepter', {'id': r.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('accepter' ~ r.id) }}">
                                <button class="btn btn--accept">Accept</button>
                            </form>
                            <form method="post" action="{{ path('app_reservation_refuser', {'id': r.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ r.id) }}">
                                <button class="btn btn--danger">Decline</button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p>No request yet.</p>
            {% endfor %}
        </div>
    {% endif %}

    {% if app.user and isDone %}
        <h2>Rate</h2>
        <div class="panel">
            {% set aNoter = 0 %}
            {% for r in reservations %}
                {% if r.statut == constant('App\\Entity\\Reservation::STATUS_CONFIRME') %}
                    {% if isOwner %}
                        {% set aNoter = aNoter + 1 %}
                        <p><a href="{{ path('app_avis_noter', {'id': trajet.id, 'cibleId': r.idPassager.id}) }}">Rate {{ r.idPassager.prenom }}</a></p>
                    {% elseif app.user.id == r.idPassager.id %}
                        {% set aNoter = aNoter + 1 %}
                        <p><a href="{{ path('app_avis_noter', {'id': trajet.id, 'cibleId': trajet.idConducteur.id}) }}">Rate the driver</a></p>
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% if aNoter == 0 %}<p>Nobody to rate for this ride.</p>{% endif %}
        </div>
    {% endif %}

    <a class="back-link" href="{{ path('app_trajets_index') }}">← Back to rides</a>
</div>
{% endblock %}
