{% extends 'base.html.twig' %}

{% block title %}Edit ride{% endblock %}

{% block body %}
<div class="page page--narrow">
    <header class="page-head">
        <div>
            <h1 class="page-title">Edit ride</h1>
            <p class="page-subtitle">{{ trajet.origine }} → {{ trajet.destination }}</p>
        </div>
    </header>

    {{ include('trajets/_form.html.twig', {'button_label': 'Update ride'}) }}

    <div class="btn-row">
        <a class="btn btn--secondary" href="{{ path('app_trajets_show', {'id': trajet.id}) }}">Cancel</a>
        {{ include('trajets/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
