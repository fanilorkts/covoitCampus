{% extends 'base.html.twig' %}

{% block title %}Find a ride{% endblock %}

{% block body %}
<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-title">Find a ride</h1>
            <p class="page-subtitle">Open rides heading your way.</p>
        </div>
        {% if app.user %}
            <a class="btn btn--primary" href="{{ path('app_trajets_new') }}">Offer a ride</a>
        {% endif %}
    </header>

    <form method="get" class="filter-bar">
        <label><span>Leaving from</span>
            <input type="text" name="origine" placeholder="Départ" value="{{ app.request.query.get('origine') }}">
        </label>
        <label><span>Going to</span>
            <input type="text" name="destination" placeholder="Arrivée" value="{{ app.request.query.get('destination') }}">
        </label>
        <label><span>Date</span>
            <input type="date" name="date_saisie" value="{{ app.request.query.get('date_saisie') }}">
        </label>
        <button type="submit" class="btn btn--primary">Search</button>
    </form>

    {% if trajets|length %}
        <div class="ride-grid">
            {% for trajet in trajets %}
                <article class="trip-card">
                    <div class="trip-card__route">{{ trajet.origine }} <span>→</span> {{ trajet.destination }}</div>
                    <div class="trip-card__meta">
                        <span>{{ trajet.dateHeure ? trajet.dateHeure|date('d/m/Y H:i') : '' }}</span>
                        <span>{{ trajet.placesRestantes }} / {{ trajet.placesTotales }} places</span>
                        <span>Driver: {{ trajet.idConducteur.prenom }}</span>
                    </div>
                    <div class="trip-card__foot">
                        <span class="trip-card__price">{{ trajet.prix|number_format(2, ',', ' ') }} €</span>
                        <a class="btn btn--accept" href="{{ path('app_trajets_show', {'id': trajet.id}) }}">View ride</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-card">No ride matches your search yet.</div>
    {% endif %}
</div>
{% endblock %}
