{% extends 'base.html.twig' %}

{% block title %}Find a ride - Backseat{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto my-10 px-4">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="font-poppins text-3xl font-bold text-darkGreen">Find a ride</h1>
            <p class="text-sm text-bodyText">Open rides heading your way.</p>
        </div>
        <a href="{{ path('app_trajets_new') }}" class="px-4 py-2 bg-darkGreen text-white text-sm font-medium rounded-xl hover:bg-primaryGreen transition">
            Offer a ride
        </a>
    </div>

    <!-- Barre de filtrage / Recherche -->
    <form method="GET" action="{{ path('app_trajets_index') }}" class="bg-white p-4 rounded-2xl border border-borderDivider flex flex-col md:flex-row gap-3 items-center mb-8">
        <input type="text" name="origine" value="{{ app.request.query.get('origine') }}" placeholder="Leaving from..." class="w-full md:flex-1 p-2.5 bg-cream border border-borderDivider rounded-xl text-sm text-darkGreen focus:outline-none">
        <input type="text" name="destination" value="{{ app.request.query.get('destination') }}" placeholder="Going to..." class="w-full md:flex-1 p-2.5 bg-cream border border-borderDivider rounded-xl text-sm text-darkGreen focus:outline-none">
        <input type="date" name="date_saisie" value="{{ app.request.query.get('date_saisie') }}" class="w-full md:w-auto p-2.5 bg-cream border border-borderDivider rounded-xl text-sm text-darkGreen focus:outline-none">
        <button type="submit" class="w-full md:w-auto px-6 py-2.5 bg-darkGreen text-white rounded-xl text-sm font-medium hover:bg-primaryGreen transition">Search</button>
    </form>

    <!-- Cartes des trajets -->
    <div class="space-y-4">
        {% for trajet in trajets %}
            <div class="bg-white p-5 rounded-2xl border border-borderDivider flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-primaryGreen transition">
                <div class="flex items-center gap-4">
                    <!-- Avatar initiales -->
                    <div class="w-12 h-12 rounded-full bg-lightGreenBg text-primaryGreen flex items-center justify-center font-bold text-base font-poppins">
                        {{ trajet.idConducteur.nom|slice(0, 2)|upper }}
                    </div>
                    <div>
                        <div class="font-poppins font-semibold text-darkGreen text-lg">
                            {{ trajet.origine }} → {{ trajet.destination }}
                        </div>
                        <div class="text-xs text-bodyText mt-1">
                            {{ trajet.dateHeure|date('d/m/Y à H:i') }} • Driver: <span class="font-medium text-darkGreen">{{ trajet.idConducteur.nom }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between w-full sm:w-auto gap-6 border-t sm:border-t-0 pt-3 sm:pt-0 border-borderDivider">
                    <div class="text-left sm:text-right">
                        <span class="inline-block px-3 py-1 bg-lightGreenBg text-primaryGreen rounded-full text-xs font-semibold">
                            {{ trajet.placesRestantes }}/{{ trajet.placesTotales }} places left
                        </span>
                        {% if trajet.prix is defined %}
                            <div class="text-lg font-bold text-darkGreen mt-1">{{ trajet.prix }} €</div>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_trajets_show', {'id': trajet.id}) }}" class="px-4 py-2 bg-primaryGreen text-white text-sm font-medium rounded-xl hover:bg-darkGreen transition">
                        View ride
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-white p-8 rounded-2xl border border-borderDivider text-center text-mutedText">
                No ride matches your search yet.
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}