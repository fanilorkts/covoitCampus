{% extends 'base.html.twig' %}

{% block title %}Rate {{ cible.prenom }}{% endblock %}

{% block body %}
<div class="page page--narrow">
    <header class="page-head">
        <div>
            <h1 class="page-title">Rate {{ cible.prenom }} {{ cible.nom }}</h1>
            <p class="page-subtitle">Ride: {{ trajet.origine }} → {{ trajet.destination }}</p>
        </div>
    </header>

    <div class="form-card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn--primary">Send my review</button>
        {{ form_end(form) }}
    </div>

    <a class="back-link" href="{{ path('app_trajets_show', {'id': trajet.id}) }}">← Back to the ride</a>
</div>
{% endblock %}
