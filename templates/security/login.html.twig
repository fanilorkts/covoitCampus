{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-page">

    {# Left panel (same as sign up) #}
    <aside class="auth-brand">
        <span class="auth-brand__circle auth-brand__circle--1"></span>
        <span class="auth-brand__circle auth-brand__circle--2"></span>
        <span class="auth-brand__circle auth-brand__circle--3"></span>

        <div class="auth-brand__content">
            <span class="auth-brand__logo">CovoitCampus</span>
            <h2 class="auth-brand__title">
                Welcome<br>
                <span class="auth-brand__title-accent">back.</span>
            </h2>
            <p class="auth-brand__text">
                Find your rides, your bookings and your reviews.
            </p>
        </div>
    </aside>

    {# Right panel #}
    <main class="auth-form-panel">
        <div class="auth-form">
            <h1 class="auth-form__title">Log in</h1>
            <p class="auth-form__subtitle">Sign in to access your account.</p>

            {% if error %}
                <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="auth-session-info">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Log out</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="auth-field">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="auth-input" autocomplete="email" required autofocus>
                </div>

                <div class="auth-field">
                    <label for="password">Password</label>
                    <input type="password" name="_password" id="password" class="auth-input" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="auth-submit">Log in</button>
            </form>

            <p class="auth-switch">Don't have an account yet? <a href="{{ path('app_register') }}">Sign up</a></p>
        </div>
    </main>

</div>
{% endblock %}