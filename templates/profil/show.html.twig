{% extends 'base.html.twig' %}

{% block title %}{{ utilisateur.prenom }} {{ utilisateur.nom }}{% endblock %}

{% block body %}
<div class="page page--narrow">
    <header class="page-head">
        <div>
            <h1 class="page-title">{{ utilisateur.prenom }} {{ utilisateur.nom }}</h1>
            <p class="page-subtitle">CovoitCampus member</p>
        </div>
        {% if app.user and app.user.id == utilisateur.id %}
            <a class="btn btn--edit" href="{{ path('app_profil_modifier') }}">Edit my profile</a>
        {% endif %}
    </header>

    <div class="panel-grid">
        <div class="kpi">
            <strong>{% if note > 0 %}{{ note|number_format(1, ',') }}/5{% else %}–{% endif %}</strong>
            <span>Average rating</span>
        </div>
        <div class="kpi"><strong>{{ nbTrajets }}</strong><span>Rides completed</span></div>
    </div>

    {% if utilisateur.biographie %}
        <div class="panel panel--clay">
            <h3>About</h3>
            <p>{{ utilisateur.biographie|nl2br }}</p>
        </div>
    {% endif %}

    {% if utilisateur.centresInteret %}
        <div class="panel">
            <h3>Interests</h3>
            <div class="tags">
                {% for interet in utilisateur.centresInteret|split(',') %}
                    {% if interet|trim %}<span class="tag">{{ interet|trim }}</span>{% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <h2>Reviews received</h2>
    <div class="panel">
        {% for a in avis %}
            <div class="review-line">
                <strong>{{ a.note }}/5</strong> — {{ a.commentaire }}<br>
                <small>by {{ a.auteur.prenom }}, {{ a.date|date('d/m/Y') }}</small>
            </div>
        {% else %}
            <p>No review yet.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
