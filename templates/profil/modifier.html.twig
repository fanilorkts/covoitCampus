{% extends 'base.html.twig' %}

{% block title %}Edit my profile{% endblock %}

{% block body %}
<div class="page page--narrow">
    <header class="page-head">
        <div>
            <h1 class="page-title">Edit my profile</h1>
            <p class="page-subtitle">Tell other members a bit about you.</p>
        </div>
    </header>

    <div class="form-card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn--primary">Save</button>
        {{ form_end(form) }}
    </div>

    <a class="back-link" href="{{ path('app_profil', {'id': app.user.id}) }}">← Back to my profile</a>
</div>
{% endblock %}
