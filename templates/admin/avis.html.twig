{% extends 'base.html.twig' %}

{% block title %}Review moderation{% endblock %}

{% block body %}
<div class="page">
    <header class="page-head"><h1 class="page-title">Review moderation</h1></header>

    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Date</th><th>Author</th><th>Target</th><th>Rating</th><th>Comment</th><th></th></tr></thead>
            <tbody>
            {% for a in avis %}
                <tr>
                    <td>{{ a.date|date('d/m/Y') }}</td>
                    <td>{{ a.auteur.prenom }} {{ a.auteur.nom }}</td>
                    <td>{{ a.cible.prenom }} {{ a.cible.nom }}</td>
                    <td>{{ a.note }}/5</td>
                    <td>{{ a.commentaire }}</td>
                    <td>
                        <form method="post" action="{{ path('app_admin_avis_supprimer', {'id': a.id}) }}" onsubmit="return confirm('Supprimer cet avis ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('supprimer_avis' ~ a.id) }}">
                            <button class="btn btn--danger">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="empty">No review.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <a class="back-link" href="{{ path('app_admin_index') }}">← Back to admin</a>
</div>
{% endblock %}
