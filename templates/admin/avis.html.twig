{% extends 'base.html.twig' %}

{% block title %}Review Moderation - BackSeat{% endblock %}

{% block body %}
<div class="admin-shell">
    <header class="admin-head">
        <div>
            <span class="admin-eyebrow">BackSeat / Administration</span>
            <h1 class="admin-title">Review moderation</h1>
            <p class="admin-subtitle">Manage community reviews and remove content when necessary.</p>
        </div>
        <span class="admin-badge">Moderation</span>
    </header>

    <nav class="admin-nav" aria-label="Administration navigation">
        <a class="admin-nav__link" href="{{ path('app_admin_index') }}">Overview</a>
        <a class="admin-nav__link" href="{{ path('app_admin_utilisateurs') }}">Users</a>
        <a class="admin-nav__link admin-nav__link--active" href="{{ path('app_admin_avis') }}">Reviews</a>
    </nav>

    <section class="admin-panel admin-panel--table">
        <div class="admin-panel__head">
            <div>
                <span class="admin-panel__kicker">Community</span>
                <h2>Latest reviews</h2>
            </div>
            <span class="admin-count">{{ avis|length }} review{{ avis|length == 1 ? '' : 's' }}</span>
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Author</th>
                        <th>Target</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th class="admin-table__action">Action</th>
                    </tr>
                </thead>
                <tbody>
                {% for a in avis %}
                    <tr>
                        <td class="admin-table__muted">{{ a.date|date('d/m/Y') }}</td>
                        <td><strong>{{ a.auteur.prenom }} {{ a.auteur.nom }}</strong></td>
                        <td>{{ a.cible.prenom }} {{ a.cible.nom }}</td>
                        <td><span class="admin-rating">{{ a.note }}/5</span></td>
                        <td class="admin-comment">{{ a.commentaire }}</td>
                        <td class="admin-table__action">
                            <form method="post" action="{{ path('app_admin_avis_supprimer', {'id': a.id}) }}" onsubmit="return confirm('Supprimer cet avis ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_avis' ~ a.id) }}">
                                <button class="admin-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="admin-empty">No reviews to display.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <a class="admin-back" href="{{ path('app_admin_index') }}">← Back to dashboard</a>
</div>
{% endblock %}
