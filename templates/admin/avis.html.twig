{% extends 'base.html.twig' %}

{% block title %}Modération des avis{% endblock %}

{% block body %}
    <h1>Modération des avis</h1>
    <table class="table">
        <thead><tr><th>Date</th><th>Auteur</th><th>Cible</th><th>Note</th><th>Commentaire</th><th></th></tr></thead>
        <tbody>
        {% for a in avis %}
            <tr>
                <td>{{ a.date|date('d/m/Y') }}</td>
                <td>{{ a.auteur.prenom }} {{ a.auteur.nom }}</td>
                <td>{{ a.cible.prenom }} {{ a.cible.nom }}</td>
                <td>{{ a.note }}/5</td>
                <td>{{ a.commentaire }}</td>
                <td>
                    <form method="post" action="{{ path('app_admin_avis_supprimer', {'id': a.id}) }}" onsubmit="return confirm('Supprimer cet avis ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_avis' ~ a.id) }}">
                        <button>Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">Aucun avis.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_admin_index') }}">Retour</a>
{% endblock %}