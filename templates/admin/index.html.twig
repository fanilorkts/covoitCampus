{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - BackSeat{% endblock %}

{% block body %}
<div class="admin-shell">
    <header class="admin-head">
        <div>
            <span class="admin-eyebrow">BackSeat / Administration</span>
            <h1 class="admin-title">Dashboard</h1>
            <p class="admin-subtitle">Monitor the platform, manage users and moderate reviews.</p>
        </div>
        <span class="admin-badge">Admin back-office</span>
    </header>

    <nav class="admin-nav" aria-label="Administration navigation">
        <a class="admin-nav__link admin-nav__link--active" href="{{ path('app_admin_index') }}">Overview</a>
        <a class="admin-nav__link" href="{{ path('app_admin_utilisateurs') }}">Users</a>
        <a class="admin-nav__link" href="{{ path('app_admin_avis') }}">Reviews</a>
    </nav>

    <section class="admin-stats" aria-label="Platform statistics">
        <article class="admin-stat admin-stat--indigo">
            <span class="admin-stat__label">Completed rides</span>
            <strong class="admin-stat__value">{{ nbTermines|default(0) }}</strong>
            <span class="admin-stat__note">Finished trips on the platform</span>
        </article>

        <article class="admin-stat">
            <span class="admin-stat__label">Average fill rate</span>
            <strong class="admin-stat__value">{{ taux|default(0)|number_format(0) }}%</strong>
            <span class="admin-stat__note">Confirmed seats on completed rides</span>
        </article>

        <article class="admin-stat admin-stat--lavender">
            <span class="admin-stat__label">Registered users</span>
            <strong class="admin-stat__value">{{ nbUtilisateurs|default(0) }}</strong>
            <span class="admin-stat__note">Drivers and passengers</span>
        </article>

        <article class="admin-stat admin-stat--amber">
            <span class="admin-stat__label">Reviews</span>
            <strong class="admin-stat__value">{{ nbAvis|default(0) }}</strong>
            <span class="admin-stat__note">Reviews currently stored</span>
        </article>
    </section>

    <section class="admin-grid">
        <article class="admin-panel admin-panel--main">
            <div class="admin-panel__head">
                <div>
                    <span class="admin-panel__kicker">Quick access</span>
                    <h2>Administration tools</h2>
                </div>
            </div>

            <div class="admin-tools">
                <a class="admin-tool" href="{{ path('app_admin_utilisateurs') }}">
                    <span class="admin-tool__icon admin-tool__icon--indigo">01</span>
                    <span>
                        <strong>Account management</strong>
                        <small>View users and change administrator roles.</small>
                    </span>
                    <span class="admin-tool__arrow">→</span>
                </a>

                <a class="admin-tool" href="{{ path('app_admin_avis') }}">
                    <span class="admin-tool__icon admin-tool__icon--amber">02</span>
                    <span>
                        <strong>Review moderation</strong>
                        <small>Review comments and remove inappropriate content.</small>
                    </span>
                    <span class="admin-tool__arrow">→</span>
                </a>
            </div>
        </article>

        <aside class="admin-panel admin-panel--accent">
            <span class="admin-panel__kicker">Admin area</span>
            <h2>Keep BackSeat healthy.</h2>
            <p>Use the administration tools to keep accounts and community reviews up to date.</p>
            <div class="admin-panel__mark">B</div>
        </aside>
    </section>
</div>
{% endblock %}
